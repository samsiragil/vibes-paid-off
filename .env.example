# Donation links (Fase 10). Empty = footer button falls back to /support.
NEXT_PUBLIC_DONATE_URL_ID=
NEXT_PUBLIC_DONATE_URL_EN=

# Supabase (Fase 2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Cloudflare R2 (Fase 3). Server-only except NEXT_PUBLIC_MEDIA_BASE_URL (public image domain,
# e.g. https://img.vibespaidoff.dev, no trailing slash). After filling these in, run
# `pnpm r2:setup` once per bucket (tmp/ lifecycle rule + CORS for browser uploads).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
NEXT_PUBLIC_MEDIA_BASE_URL=

# Cloudflare Turnstile (Fase 4)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
