# Public origin of the site, no trailing slash (Open Graph images, share links).
# Empty = the Vercel production domain, or http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=

# Donation links (Fase 10, Q16): local platform (Saweria/Trakteer) for /id and the "Dari Indonesia"
# card, global one (Buy Me a Coffee/Ko-fi) for /en and the "From abroad" card. https only. Empty =
# the footer button falls back to /support and the card says the link is coming soon.
NEXT_PUBLIC_DONATE_URL_ID=
NEXT_PUBLIC_DONATE_URL_EN=

# Cloudflare Web Analytics (Fase 10): the site token from Cloudflare dashboard → Analytics & Logs →
# Web Analytics → Add a site → "Manage site" (the token in the JS snippet). Empty = no beacon.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# Supabase (Fase 2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Cloudflare R2 (Fase 3). Server-only except NEXT_PUBLIC_MEDIA_BASE_URL (public image domain,
# e.g. https://img.jadinya.dev, no trailing slash). After filling these in, run
# `pnpm r2:setup` once per bucket (tmp/ lifecycle rule + CORS for browser uploads).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
NEXT_PUBLIC_MEDIA_BASE_URL=

# Database backups (Fase 9): a separate private bucket (never the media bucket) and, ideally, a
# token with Object Read & Write on that bucket only. Empty token = the R2_* token above.
# Only needed locally for `pnpm backup:r2 list|download`; see docs/operations.md.
R2_BACKUP_BUCKET=
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=

# Cloudflare Turnstile (Fase 4). Empty = no widget, and the server skips the check outside Vercel
# production (production without the secret rejects new submissions). Cloudflare's test keys
# always pass: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Review notification emails (Fase 8, Q10): Resend API key and a sender on a verified domain,
# e.g. "Jadinya <halo@jadinya.dev>". Empty = no email; makers see the outcome on /me.
RESEND_API_KEY=
EMAIL_FROM=
